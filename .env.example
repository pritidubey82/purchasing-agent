# Copy this file to .env and fill in your own values. Never commit .env.
# Any OpenAI-compatible provider works (Gemini, Groq, OpenRouter, Ollama ...).
# Check your provider's docs for the exact base URL and model name.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-key-here
LLM_MODEL=your-model-name-here
